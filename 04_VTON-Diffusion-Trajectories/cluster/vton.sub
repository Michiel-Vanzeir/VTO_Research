# One trajectory-capture run. Not submitted directly: submit.sh generates a
# DAG that instantiates this once per (model, pair) with VARS for
# model/pair/person/cloth/mode, the log name and the per-model GPU/RAM needs, plus a final
# analysis node (analyze.sub).
universe   = vanilla
executable = run_job.sh
arguments  = $(model) $(pair) $(person) $(cloth) $(mode)

# Shared filesystem: the job reads code, envs, weights and data in place and
# writes straight into outputs/ -- nothing is transferred.
should_transfer_files = NO

request_gpus   = 1
request_cpus   = 4
request_memory = $(mem)
request_disk   = 10GB

# Minimum GPU memory per model (set by submit.sh). Written against both GPU
# ClassAd spellings in use (older CUDA* and newer GPUs_*); whichever this
# pool doesn't advertise evaluates UNDEFINED and drops out of the ||.
#
# BadHosts: nodes that advertise a GPU but where torch sees none (no working
# driver) -- jobs there fail instantly, and DAG retries tend to land on the
# same node again. Add hostnames here (comma-separated, no quotes) if
# run_job.sh reports "torch sees no GPU".
BadHosts = psi-test2.esat.kuleuven.be
requirements = ((TARGET.CUDAGlobalMemoryMb >= $(gpumem)) || (TARGET.GPUs_GlobalMemoryMb >= $(gpumem))) \
               && !stringListMember(TARGET.Machine, "$(BadHosts)")

# ESAT asks jobs to declare a walltime (seconds), set by submit.sh: 4h for a
# trajectory run (a 50-step IDM-VTON run is ~10-20 min on a 24GB card), 8h
# for a fork job (28 full runs, no frame decoding). Fork jobs resume where
# they stopped, so a retry after a walltime kill only does what's left.
+RequestWalltime = $(walltime)

output = logs/$(logname).out
error  = logs/$(logname).err
log    = logs/$(logname).log
queue
